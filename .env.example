# Copia este archivo como ".env" (sin .example) en la misma carpeta,
# y pon ahí tus credenciales reales de MySQL Workbench.
# El archivo ".env" real NUNCA se sube a GitHub (ya está en .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=ARKHE_V1

# OBLIGATORIA: clave con la que Flask firma la sesión (el inicio de
# sesión) y los mensajes flash. Sin ella la aplicación no arranca.
# Genera una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opcional: 1 activa el modo depuración (recarga automática y errores
# detallados). Solo para desarrollo en tu propio equipo.
FLASK_DEBUG=0
