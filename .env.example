# Copia este archivo como ".env" (sin .example) en la misma carpeta,
# y pon ahí tus credenciales reales de MySQL Workbench.
# El archivo ".env" real NUNCA se sube a GitHub (ya está en .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=ARKHE_V1

# Opcional: clave usada por Flask para firmar la sesión y los mensajes
# flash. Si no se define, se usa una clave de desarrollo por defecto
# (ver config.py).
SECRET_KEY=cambia-esto-por-una-clave-cualquiera
